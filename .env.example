# --- ديسكورد ---
# بوت الإنتاج: الرمز المميز ومعرّف التطبيق من https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# بوت الاختبار (تطبيق منفصل). اضبط القيمتين معًا أو اتركهما فارغتين. عند ضبطهما، يستخدم `bun run dev` و`commands:deploy`
# هاتين القيمتين بدلًا من قيم الإنتاج؛ ملف Compose الخاص بالإنتاج لا يمررهما إلى الحاوية أبدًا.
DISCORD_DEV_TOKEN=
DISCORD_DEV_CLIENT_ID=
# اختياري: سجّل أوامر الشرطة المائلة في هذا الخادم فقط (لتحديثات فورية أثناء التطوير).
# اتركه فارغًا لتسجيلها على جميع الخوادم.
DISCORD_DEV_GUILD_ID=
# يسجّل البوت أوامر الشرطة المائلة عند التشغيل (في خادم التطوير أعلاه، أو عالميًا إن لم يُحدّد) عندما تختلف أوامر ديسكورد عن الموجودة في الكود.
# عطّل ذلك بالقيمة false، مثلًا عند مشاركة التطبيق بين عدة نسخ.
COMMANDS_AUTO_DEPLOY=true
# القيمة 1 تنشر المجموعة العامة حتى مع تحديد خادم تطوير، وتفرغ أوامر ذلك الخادم (للبوت وcommands:deploy).
DEPLOY_GLOBAL=
# بادئة أوامر النص في الخوادم التي لم تضبط بادئة خاصة بها.
BOT_PREFIX=!

# --- كلمات المرور ---
# ستُستخدم داخل عناوين الاتصال، لذلك استخدم محارف آمنة لعناوين URL (`openssl rand -hex 32` على الخادم).
# يقرأ الإنتاج (`bun run prod:up` وdocs/DEPLOYMENT.md) كلمات المرور الثلاث من هذا الملف ويبني عناوين URL بنفسه؛ وقيم *_URL أدناه مخصصة للتطوير المحلي فقط.
# لا تصبح POSTGRES_PASSWORD فعّالة إلا عند إنشاء وحدة تخزين قاعدة البيانات أول مرة؛ غيّرها باستخدام ALTER USER أولًا (راجع docs/DEPLOYMENT.md).

# --- PostgreSQL (إعدادات الخوادم والبيانات الدائمة) ---
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://dzajcarz:${POSTGRES_PASSWORD}@localhost:5432/dzajcarz

# --- Redis (الذاكرة المؤقتة وفترات الانتظار والحالة قصيرة العمر) ---
# يقرأ Compose قيمة REDIS_PASSWORD؛ ويقرأ البوت REDIS_URL عند تشغيله خارج Docker.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- الاختبارات ---
# تتخطى مجموعتا اختبارات قاعدة البيانات وRedis الاختبارات عند غياب هاتين القيمتين. يستخدم كل تشغيل مخططًا وبادئة مفاتيح خاصة به، لذلك يمكنه بأمان استخدام
# خدمات Compose التي يشغّلها `bun run infra:up` (أما CI فيستخدم خدمات مؤقتة).
# TEST_DATABASE_URL=postgres://dzajcarz:${POSTGRES_PASSWORD}@localhost:5432/dzajcarz
# TEST_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- Lavalink (وحدة الموسيقى، `docker compose --profile music`) ---
# اختياري للبوت: اترك القيمتين فارغتين للتشغيل دون موسيقى. يحتاج Compose إلى كلمة مرور العقدة.
LAVALINK_PASSWORD=change-me-lavalink-password
LAVALINK_URL=http://localhost:2333

# --- الوقت ---
# اختياري. منطقة خوادم لم تختر منطقة زمنية باستخدام /timezone (اسم وفق IANA).
# DEFAULT_TIME_ZONE=Europe/Warsaw
# اختياري. تعبير Cron من خمسة حقول للأغنية المجدولة، ويُقرأ وفق ساعة كل خادم. الإعداد الافتراضي: 09:00 و21:00.
# SCHEDULED_SONG_CRON=0 9,21 * * *

# --- نقطة فحص الصحة (GET /health: البوابة وPostgres وRedis) ---
# تعطل HEALTH_PORT=0 نقطة الفحص.
HEALTH_PORT=8080
# تضبط صورة Docker القيمة 0.0.0.0 حتى يصل إليها المنفذ المنشور؛ وتكفي 127.0.0.1 عند التشغيل محليًا.
# HEALTH_HOSTNAME=127.0.0.1
# للإنتاج فقط: منفذ المضيف الذي ينشر Compose نقطة الفحص عليه، وهو مرتبط دائمًا بـ127.0.0.1.
# HEALTH_PUBLISH_PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# مفاتيح API الخاصة بـRiot Games، مفتاح لكل لعبة (كلاهما اختياري؛ يتعطل /valorant و/lol عند غياب مفتاح كل منهما)
RIOT_VALORANT_API_KEY=
RIOT_LOL_API_KEY=
